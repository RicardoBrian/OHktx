# 서버 포트
PORT=3000

# 이 웹앱 자체에 로그인할 때 쓰는 비밀번호 (개인용 단일 사용자). 반드시 변경하세요.
APP_PASSWORD=change-me

# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -hex 32 로 생성)
SESSION_SECRET=change-me

# 코레일 계정/카드정보 암호화용 키 (32바이트 hex, openssl rand -hex 32 로 생성)
ENCRYPTION_KEY=change-me-64-hex-chars

# 텔레그램 알림 (https://t.me/BotFather 에서 봇 생성 후 토큰 발급, 본인 chat_id 확인)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# watch 폴링 주기 (ms). 코레일 서버 부하/차단 방지를 위해 너무 짧게 잡지 마세요.
POLL_INTERVAL_MS=15000

# 자동화 브라우저를 화면에 띄워서 디버깅할지 여부 (true/false)
BROWSER_HEADLESS=true

# (선택) playwright가 설치한 크로미움 버전과 시스템에 이미 있는 크로미움 버전이 안 맞을 때,
# 크로미움 실행 파일 경로를 직접 지정. 보통은 비워두면 됨.
PLAYWRIGHT_CHROMIUM_PATH=

# (선택) 크로미움 샌드박스가 거부되는 환경(root로 실행 등)에서만 true로. 일반적으론 비워두세요.
CHROMIUM_NO_SANDBOX=
